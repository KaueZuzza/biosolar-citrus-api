# BioSolar Citrus: variáveis de ambiente (modelo)
#
# Copie para ".env" (o .env NUNCA vai para o Git) e ajuste se necessário.
# scripts/setup-ambiente.ps1 e scripts/iniciar.ps1 carregam o .env automaticamente.
# Sem .env, os valores abaixo são usados como padrão.
#
# ATENÇÃO: são credenciais de DESENVOLVIMENTO LOCAL, não senhas reais.

# Banco de dados usado pela API
BIOSOLAR_DB_URL=jdbc:postgresql://localhost:5432/biosolar
BIOSOLAR_DB_USUARIO=biosolar
BIOSOLAR_DB_SENHA=biosolar

# Senha do superusuário "postgres" do cluster PORTÁTIL criado por setup-ambiente.ps1
BIOSOLAR_PG_SUPER_SENHA=postgres

# Origens do navegador aceitas pela API (CORS). O dashboard servido em http://localhost:8080 não depende disso.
BIOSOLAR_CORS_ORIGENS=http://localhost:[*],http://127.0.0.1:[*],null

# Painel de simulação (/simulacao/*): true para a demonstração, false para desativar
BIOSOLAR_CONTROLES_DEMO=true

# Porta da API e do dashboard
PORT=8080
